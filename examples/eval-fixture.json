{
  "cases": [
    {"name": "healthy cert, covered listener",
     "certificate": {"name": "ok", "not_after": "2027-01-01T00:00:00Z",
       "signature_algorithm": "sha256WithRSAEncryption", "key_algorithm": "RSA",
       "key_size": 2048, "sans": ["a.example.com"]},
     "listeners": [{"name": "l", "hostname": "a.example.com"}],
     "expect_rules": []},
    {"name": "expired + weak sig + small key stack",
     "certificate": {"name": "bad", "not_after": "2026-10-01T00:00:00Z",
       "signature_algorithm": "sha1WithRSAEncryption", "key_algorithm": "RSA",
       "key_size": 1024, "sans": ["a.example.com"]},
     "expect_rules": ["EXP001", "SIG001", "KEY001"]},
    {"name": "wildcard cert covers listener",
     "certificate": {"name": "wc", "not_after": "2027-01-01T00:00:00Z",
       "signature_algorithm": "sha256WithRSAEncryption", "key_algorithm": "RSA",
       "key_size": 2048, "sans": ["*.example.com"]},
     "listeners": [{"name": "l", "hostname": "api.example.com"}],
     "expect_rules": []},
    {"name": "expiring soon, orphan, uncovered listener",
     "certificate": {"name": "o", "not_after": "2026-11-05T00:00:00Z",
       "signature_algorithm": "sha256WithRSAEncryption", "key_algorithm": "RSA",
       "key_size": 2048, "sans": ["zzz.other.com"]},
     "listeners": [{"name": "l", "hostname": "a.example.com"}],
     "expect_rules": ["EXP002", "SAN001", "SAN002"]},
    {"name": "unparseable record is a finding, not a crash",
     "certificate": {"name": "broken"},
     "expect_rules": ["BAD001"]},
    {"name": "no SANs cannot prove coverage",
     "certificate": {"name": "nosan", "not_after": "2027-01-01T00:00:00Z",
       "signature_algorithm": "sha256WithRSAEncryption", "key_algorithm": "RSA",
       "key_size": 2048, "sans": []},
     "expect_rules": ["SAN003"]}
  ]
}
